<group name="tfm,lateral_movement,">

  <!--
    Rule 100001
    Process execution observed after the RDP scenario.
    Public version: replace "standard_user" with the actual lab username
    in private deployments.
  -->
  <rule id="100001" level="10">
    <if_sid>67027</if_sid>
    <field name="win.eventdata.targetUserName">^standard_user$</field>
    <description>TFM - Post-access process execution after RDP session (T1021.001 context)</description>
    <group>tfm,lateral_movement,rdp,post_access,</group>
    <mitre>
      <id>T1021.001</id>
    </mitre>
  </rule>

  <!--
    Rule 100010
    Remote service creation compatible with PsExec-like SMB lateral movement.
  -->
  <rule id="100010" level="12">
    <if_sid>61138</if_sid>
    <field name="win.system.eventID">^7045$</field>
    <field name="win.system.providerName">^Service Control Manager$</field>
    <field name="win.eventdata.accountName">^LocalSystem$</field>
    <description>TFM - Remote service creation compatible with PsExec-like SMB lateral movement (T1021.002)</description>
    <group>tfm,lateral_movement,smb,psexec,service_creation,</group>
    <mitre>
      <id>T1021.002</id>
      <id>T1569.002</id>
    </mitre>
  </rule>

  <!--
    Rule 100011
    NTLM network logon observed as a shared indicator for SMB/PsExec-like
    and Pass-the-Hash scenarios.
  -->
  <rule id="100011" level="10">
    <if_sid>92652</if_sid>
    <field name="win.eventdata.authenticationPackageName">^NTLM$</field>
    <description>TFM - NTLM network logon observed: shared indicator for SMB/PsExec or Pass-the-Hash scenario</description>
    <group>tfm,lateral_movement,ntlm,shared_indicator,</group>
    <mitre>
      <id>T1021.002</id>
      <id>T1550.002</id>
    </mitre>
  </rule>

  <!--
    Rule 100021
    Special privileges assigned to a non-system account.
  -->
  <rule id="100021" level="12">
    <if_sid>67028</if_sid>
    <field
      name="win.eventdata.subjectUserName"
      negate="yes"
      type="pcre2">(?i)^(SYSTEM|LOCAL SERVICE|NETWORK SERVICE|.*\$)$</field>
    <description>TFM - Special privileges assigned to privileged remote session: shared lateral movement indicator</description>
    <group>tfm,lateral_movement,privileged_access,shared_indicator,</group>
    <mitre>
      <id>T1078</id>
      <id>T1550.002</id>
    </mitre>
  </rule>

  <!--
    Rule 100022
    Controlled laboratory chain: Windows Defender disabled followed
    by privileged access.
  -->
  <rule id="100022" level="14" frequency="2" timeframe="300">
    <if_matched_sid>92008</if_matched_sid>
    <if_sid>100021</if_sid>
    <description>TFM - Controlled Pass the Hash chain: Defender disabled followed by privileged access (T1550.002 + T1562.001)</description>
    <options>alert_by_email</options>
    <group>tfm,lateral_movement,pth_controlled,defense_evasion,correlation,</group>
    <mitre>
      <id>T1550.002</id>
      <id>T1562.001</id>
    </mitre>
  </rule>

  <!--
    Rule 100030
    DCSync / secretsdump-like activity based on Active Directory
    replication-rights usage.
  -->
  <rule id="100030" level="13">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4662$</field>
    <field name="win.eventdata.accessMask" type="pcre2">(?i)^0x100$</field>
    <field
      name="win.eventdata.properties"
      type="pcre2">(?i)(1131f6aa-9c07-11d1-f79f-00c04fc2dcd2|1131f6ad-9c07-11d1-f79f-00c04fc2dcd2|89e95b76-444d-4c62-991a-0facbeda640c|Replicating Directory Changes)</field>
    <field
      name="win.eventdata.subjectUserName"
      negate="yes"
      type="pcre2">.*\$$</field>
    <description>TFM - Possible DCSync/secretsdump activity: AD replication rights used by non-machine account (T1003.006)</description>
    <group>tfm,credential_access,dcsync,</group>
    <mitre>
      <id>T1003.006</id>
    </mitre>
  </rule>

  <!--
    Rule 100033
    Critical correlation: DCSync-like activity followed by privileged access.
  -->
  <rule id="100033" level="15" frequency="2" timeframe="300">
    <if_matched_sid>100030</if_matched_sid>
    <if_sid>100021</if_sid>
    <same_field>win.eventdata.subjectUserName</same_field>
    <description>TFM - Controlled Pass the Hash chain: DCSync/secretsdump followed by privileged access using the same account (T1550.002 + T1003.006)</description>
    <options>alert_by_email</options>
    <group>tfm,lateral_movement,pth_controlled,credential_access,correlation,</group>
    <mitre>
      <id>T1550.002</id>
      <id>T1003.006</id>
    </mitre>
  </rule>

</group>

<!-- ====================================================== -->
<!-- Kerberoasting - MITRE ATT&CK T1558.003                 -->
<!-- ====================================================== -->

<group name="tfm,credential_access,kerberos,kerberoasting,">

  <!--
    Rule 100040 / H8
    Kerberos service ticket issued using RC4-HMAC from a source
    outside the approved laboratory list.
  -->
  <rule id="100040" level="12">
    <if_sid>60103</if_sid>

    <field name="win.system.eventID">^4769$</field>

    <field name="win.eventdata.ticketEncryptionType">^0x17$</field>

    <field
      name="win.eventdata.ipAddress"
      type="pcre2"
      negate="yes">^(?:(?:::ffff:)?192\.168\.56\.(?:20|30)|::1|127\.0\.0\.1)$</field>

    <description>TFM - Kerberoasting: RC4 TGS request from an unapproved source (T1558.003)</description>

    <group>tfm,credential_access,kerberos,kerberoasting,</group>

    <mitre>
      <id>T1558.003</id>
    </mitre>
  </rule>

  <!--
    Rule 100041 / H9
    Three rule 100040 matches from the same source address
    within 120 seconds.
  -->
  <rule
    id="100041"
    level="15"
    frequency="3"
    timeframe="120"
    ignore="120">

    <if_matched_sid>100040</if_matched_sid>

    <same_field>win.eventdata.ipAddress</same_field>

    <description>TFM - Kerberoasting critical correlation: 3 RC4 TGS requests from the same unapproved source in 120 seconds (T1558.003)</description>

    <group>tfm,credential_access,kerberos,kerberoasting,correlation,</group>

    <mitre>
      <id>T1558.003</id>
    </mitre>
  </rule>

  <!--
    Rule 100042 / H10
    Supporting endpoint detection. A process other than lsass.exe
    connects from WS01 to the Kerberos service on DC01.
  -->
  <rule id="100042" level="13">
    <if_sid>61605</if_sid>

    <field
      name="win.system.computer"
      type="pcre2">(?i)^WS01\.lab\.local$</field>

    <field name="win.eventdata.destinationIp">^192\.168\.56\.20$</field>

    <field name="win.eventdata.destinationPort">^88$</field>

    <field
      name="win.eventdata.image"
      type="pcre2"
      negate="yes">(?i)\\Windows\\System32\\lsass\.exe$</field>

    <description>TFM - Unusual process other than lsass.exe connected to the Kerberos service on DC01 (T1558.003)</description>

    <group>tfm,credential_access,kerberos,kerberoasting,sysmon,</group>

    <mitre>
      <id>T1558.003</id>
    </mitre>
  </rule>

</group>
